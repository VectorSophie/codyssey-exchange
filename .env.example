# Codyssey Exchange — 환경 변수 예시 (실제 값은 커밋하지 않는다)

# 과제 카탈로그/평가 시장 데이터가 들어있는 Postgres. 로컬은 docker-compose up -d db 후:
# postgres://codyssey:codyssey@localhost:5432/codyssey_exchange
# 배포 환경은 Neon/Supabase 등 관리형 Postgres(무료 티어로 충분한 규모)를 권장한다.
DATABASE_URL=

# /me, /level-exam의 실시간 개인 데이터 연동에 필요.
# usr.codyssey.kr 로그인 후 개발자도구 F12 → Application → Cookies → JSESSIONID 값을
# "JSESSIONID=xxxx" 형태로 붙여넣는다. 본인 세션으로 본인 데이터만 읽기 전용으로, 매 요청마다 조회한다.
# 비워두면 데모 페르소나로 자동 폴백한다.
CODYSSEY_SESSION=
